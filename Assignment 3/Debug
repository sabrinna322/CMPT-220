import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        try (Scanner sc = new Scanner(System.in)) {

        System.out.println("Problem 1");
        for (int i = 1; i <= 10; i++) {
            System.out.println(i);
        }

        System.out.println("Problem 2");
        System.out.println("Enter a number, and I will tell you the factorial: ");
        int num = sc.nextInt();
        long factorial = 1;
        if (num < 0) {
            System.out.println("Factorial does not work with negatives...");
        } else {
            for (int i = 1; i <= num; i++) 
                factorial *= i;
        }
        System.out.println("The factorial of " + num + " is: " + factorial);

        System.out.println("Problem 3");
        System.out.println("Enter a number, and I will tell you the sum of every other number: ");
        int num2 = sc.nextInt();
        int summ = 0;
        for (int i = 1; i <= num2; i += 2) {
            summ += i;
        }
        System.out.println("The sum of " + num2 + " is: " + summ);

        System.out.println("Problem 4");
        boolean run = true;
        while (run == true) {
            System.out.println("I printed once!");
            run = false; 
        }

        System.out.println("Problem 5");
        System.out.println("Give me a string: ");
        String original = sc.nextLine();
        String result = "";
        for (int i = original.length() - 1; i >= 0; i--) {
            result += original.charAt(i);
        System.out.println("Reversed String: " + result);
        }
        }
    }
}
