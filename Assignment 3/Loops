import java.util.Scanner;
public class PrintLetters {
    public static void main(String[] args) {
        //First, I knew I needed three main things:
        //(1) I needed to use Scanner to get input from the user.
        //(2) After doing some Googling, I found that using charAt() is how to access each individual letter of a string.
        //(3) I used a for loop to iterate through the given string.
        Scanner sc = new Scanner(System.in);
        System.out.println("Write a short sentence here: ");
        String input = sc.nextLine();
        //Here, I used the inputted strings length as the ending point to ensure the loop stops before going past the last character.
        for (int i = 0; i < input.length(); i++) {
            //This part actually pulls each letter out of the string and prints it on a new line. 
            System.out.println(input.charAt(i));
        }
        String result = ""; 
        //Here, each character of the string is appended in reverse order to a new string 'result,' which becomes the reversed output.
        for (int i = 0; i < input.length(); i++) {
            result = input.charAt(i) + result;
        }
        System.out.println(result);
        sc.close();
    }
}
